# Copie para deploy.env (mesma pasta) e ajuste. O deploy.env não deve ir para o git.

# Onde entrar por SSH: usuario@ip ou um apelido do ~/.ssh/config. O login precisa ser por CHAVE
# (sem senha) e o usuário precisa poder usar o Docker (estar no grupo "docker").
CRONOSYNC_SSH=usuario@ip-da-vps

# Pasta na VPS (dentro da home do usuário) onde o servidor fica. Opcional.
# CRONOSYNC_REMOTE_DIR=cronosync-homologacao
